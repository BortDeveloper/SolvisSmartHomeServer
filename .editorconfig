# Einheitliche Editor-Einstellungen (verhindert Encoding-/Zeilenende-Drift).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java: Tabs (bestehender Projektstil)
[*.java]
indent_style = tab

[*.{xml,xsd,yml,yaml,md,properties}]
indent_style = space
indent_size = 2

# Maven-Wrapper-Skripte nicht anfassen
[mvnw]
trim_trailing_whitespace = false
